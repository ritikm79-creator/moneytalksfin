# WhatsApp number: country code + digits only, e.g. 919XXXXXXXXX. Empty hides all WhatsApp buttons.
VITE_WHATSAPP_NUMBER=
# none | formspree | web3forms | endpoint. "none" shows an honest "pending configuration" state.
VITE_FORM_PROVIDER=none
# Formspree form URL, Web3Forms access key, or your own endpoint URL.
VITE_FORM_ENDPOINT=
